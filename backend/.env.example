# --- required ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- vector store ---
# Leave QDRANT_URL empty to use a local embedded Qdrant (no signup needed).
# Set it (+ QDRANT_API_KEY) to use Qdrant Cloud instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=maai_documents
QDRANT_MEMORY_COLLECTION=maai_memory

# --- database, for F5 text-to-SQL ---
DATABASE_URL=sqlite:///data/company.db

# --- optional extras ---
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- graph safety ---
MAX_REVISIONS=2
RECURSION_LIMIT=25
